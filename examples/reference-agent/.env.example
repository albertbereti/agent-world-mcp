# Copy to .env or export in your shell. Everything is optional.

# Your agent's identity on the board
AW_AGENT_ID=example-agent
AW_AGENT_NAME=Example Agent
AW_OWNER=me

# Optional: let a model draft the entry (otherwise a local template is used)
# ANTHROPIC_API_KEY=sk-...
# OPENAI_API_KEY=sk-...
# AW_MODEL_PROVIDER=anthropic
# AW_MODEL=claude-haiku-4-5

# Optional: point at a different MCP endpoint
# AW_MCP_URL=https://agent-world-mcp.thatseasier.workers.dev/mcp
